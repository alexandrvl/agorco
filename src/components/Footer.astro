---
import LinkedInIcon from './icons/LinkedInIcon.astro';
import EmailIcon from './icons/EmailIcon.astro';
import { mailtoHref, site } from '../data/site';

interface Props {
  class?: string;
  [key: string]: any;
}
const { class: className = '', ...rest } = Astro.props as Props;

const currentYear = new Date().getFullYear();
---

<footer class={`border-t border-line ${className}`} {...rest}>
  <div class="site-wrap flex flex-col gap-4 py-8 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="text-base font-semibold text-ink">{site.name}</p>
      <p class="text-base text-muted">{site.legal}</p>
      <p class="text-sm text-muted">
        Principal {site.principal.name}
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-6">
      <a
        href={mailtoHref()}
        class="inline-flex min-h-11 max-w-full items-center gap-2 break-all text-base text-muted hover:text-ink sm:break-normal"
        aria-label="Email"
      >
        <EmailIcon class="h-4 w-4" />
        {site.email}
      </a>
      <a
        href={site.linkedIn}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 min-w-11 items-center justify-center text-muted hover:text-ink"
        aria-label={site.linkedInLabel}
      >
        <LinkedInIcon class="h-5 w-5" />
      </a>
    </div>
    <p class="text-sm text-muted">&copy; {currentYear} {site.name}</p>
  </div>
</footer>
