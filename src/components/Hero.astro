---
import { Picture } from 'astro:assets';
import { site } from '../data/site';
import LinkedInIcon from './icons/LinkedInIcon.astro';
import studioPhoto from '../assets/studio/studio-c4-whiteboard.png';

interface Props {
  class?: string;
  [key: string]: any;
}
const { class: className = '', ...rest } = Astro.props as Props;
---

<section class={className} {...rest}>
  <div class="site-wrap section">
    <p class="eyebrow">{site.hero.eyebrow}</p>
    <p class="hero-proof">
      <a href={site.hero.proof.href}>{site.hero.proof.items.join(" · ")}</a>
    </p>
    <h1 class="section-title mt-4 max-w-3xl text-[1.65rem] leading-tight sm:text-2xl md:text-4xl">
      {site.hero.heading}
    </h1>
    <p class="mt-3 max-w-3xl text-lg font-semibold tracking-tight text-muted md:text-xl">
      {site.hero.lead}
    </p>

    <p class="mt-6 max-w-3xl text-base leading-relaxed text-ink">
      <span class="font-semibold">{site.principal.name}</span>
      <span class="text-muted"> · {site.principal.role} · {site.principal.location}</span>
      <span class="mt-2 block">{site.principal.line}</span>
    </p>

    <Picture
      src={studioPhoto}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={[640, 960, 1280, 1600]}
      sizes="(max-width: 1024px) calc(100vw - 2rem), 1024px"
      alt={site.principal.photoAlt}
      loading="eager"
      pictureAttributes={{ class: 'mt-6 block w-full max-w-3xl' }}
      class="aspect-[16/9] w-full border border-line object-cover object-top"
    />

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href={site.cta.href}
        class="inline-flex min-h-11 w-full items-center justify-center bg-accent px-5 py-2.5 text-base font-semibold text-accent-fg transition-opacity hover:opacity-90 sm:w-auto"
      >
        {site.cta.label}
      </a>
      <a
        href={site.linkedIn}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 w-full items-center justify-center gap-2 border border-line px-5 py-2.5 text-base font-medium text-ink hover:border-accent sm:w-auto"
      >
        <LinkedInIcon class="h-4 w-4" />
        {site.linkedInLabel}
      </a>
    </div>
  </div>
</section>
