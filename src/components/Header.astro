---
interface Props {
  class?: string;
  [key: string]: any;
}
const { class: className = '', ...rest } = Astro.props as Props;
---

<header class={`sticky top-0 bg-slate-50/80 backdrop-blur-md z-50 border-b border-slate-200/80 ${className}`} {...rest}>
  <div class="container mx-auto px-6 py-4">
    <div class="flex items-center justify-between">
      <a href="#" class="text-2xl font-bold text-slate-900 tracking-wider">
        agorco
      </a>
      <nav>
        <a 
          href="mailto:dev@agorco.com"
          class="px-4 py-2 text-sm font-medium text-slate-600 hover:text-sky-500 transition-colors duration-300"
        >
          Contact
        </a>
      </nav>
    </div>
  </div>
</header>
