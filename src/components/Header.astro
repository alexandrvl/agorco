---
import { site } from '../data/site';

interface Props {
  class?: string;
  [key: string]: any;
}
const { class: className = '', ...rest } = Astro.props as Props;
---

<header
  class={`sticky top-0 z-50 border-b border-line/80 bg-canvas/80 backdrop-blur-md ${className}`}
  {...rest}
>
  <div class="site-wrap flex items-center justify-between gap-2 py-3 sm:gap-4">
    <a href="/" class="shrink-0 text-lg font-semibold tracking-tight text-ink">
      {site.name}
    </a>

    <nav class="hidden items-center gap-4 md:flex lg:gap-6" aria-label="Primary">
      {site.nav.map((item) => (
        <a
          href={item.href}
          class="text-base text-muted transition-colors hover:text-ink"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={site.cta.href}
        class="inline-flex min-h-11 items-center border border-accent bg-accent px-2.5 py-2 text-sm font-semibold text-accent-fg hover:opacity-90 sm:px-3 sm:text-base"
      >
        {site.cta.shortLabel}
      </a>
      <button
        type="button"
        id="theme-toggle"
        class="inline-flex h-11 w-11 items-center justify-center border border-line text-ink"
        aria-label="Switch to light theme"
        aria-pressed="false"
      >
        <svg id="icon-sun" class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path stroke-linecap="round" d="M12 3v1.5M12 19.5V21M4.93 4.93l1.06 1.06M18.01 18.01l1.06 1.06M3 12h1.5M19.5 12H21M4.93 19.07l1.06-1.06M18.01 5.99l1.06-1.06" />
        </svg>
        <svg id="icon-moon" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5Z" />
        </svg>
      </button>

      <button
        type="button"
        id="menu-toggle"
        class="inline-flex h-11 w-11 items-center justify-center border border-line text-ink md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="hidden border-t border-line md:hidden"
    aria-label="Mobile"
  >
    <div class="site-wrap flex flex-col py-3">
      {site.nav.map((item) => (
        <a
          href={item.href}
          class="mobile-nav-link py-3 text-base text-muted hover:text-ink"
        >
          {item.label}
        </a>
      ))}
      <a
        href={site.cta.href}
        class="mobile-nav-link py-3 text-base font-semibold text-ink"
      >
        {site.cta.label}
      </a>
    </div>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const themeBtn = document.getElementById('theme-toggle');
  const sun = document.getElementById('icon-sun');
  const moon = document.getElementById('icon-moon');
  const menuBtn = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  function theme() {
    return root.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
  }

  function syncTheme() {
    const isLight = theme() === 'light';
    themeBtn?.setAttribute('aria-pressed', String(isLight));
    themeBtn?.setAttribute(
      'aria-label',
      isLight ? 'Switch to dark theme' : 'Switch to light theme'
    );
    sun?.classList.toggle('hidden', !isLight);
    moon?.classList.toggle('hidden', isLight);
  }

  themeBtn?.addEventListener('click', () => {
    const next = theme() === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    syncTheme();
  });

  menuBtn?.addEventListener('click', () => {
    const open = !mobileNav?.classList.contains('hidden');
    mobileNav?.classList.toggle('hidden', open);
    menuBtn.setAttribute('aria-expanded', String(!open));
    menuBtn.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
  });

  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      mobileNav?.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
      menuBtn?.setAttribute('aria-label', 'Open menu');
    });
  });

  syncTheme();
</script>
