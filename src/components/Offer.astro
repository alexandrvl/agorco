---
import { site } from '../data/site';

interface Props {
  class?: string;
  [key: string]: any;
}
const { class: className = '', ...rest } = Astro.props as Props;
---

<section id="approach" class={`scroll-mt-24 border-t border-line ${className}`} {...rest}>
  <div class="site-wrap section">
    <p class="eyebrow">Approach</p>
    <h2 class="section-title">{site.approach.heading}</h2>
    <p class="section-lead">{site.approach.lead}</p>
    <ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {site.approach.steps.map((step, index) => (
        <li class="card">
          <span class="flex h-8 w-8 items-center justify-center border border-line text-sm font-semibold text-accent tabular-nums">
            {index + 1}
          </span>
          <h3 class="statement mt-4 text-base">{step.title}</h3>
          <p class="mt-3 text-base leading-relaxed text-ink">{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
